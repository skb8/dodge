+int GUIAction::wifi(std::string arg)
+{
+  if (!simulate) dodge_wifi::Action(arg);
+  return 0;
+}
+
+int GUIAction::wifiprepare(std::string arg __unused)
+{
+  operation_start("Wi-Fi");
+  bool ready = simulate || dodge_wifi::PrepareDriver();
+  property_set("sys.dodge.wifi.driver_ready", ready ? "1" : "0");
+  operation_end(ready ? 0 : 1);
+  return ready ? 0 : 1;
+}
+
